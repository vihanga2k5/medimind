# Copy this file to .env and replace the placeholder values. Never commit the real .env file.
NODE_ENV=development
PORT=5000

# Use a replica set (local single-node replica set or MongoDB Atlas) so multi-document transactions are available.
MONGODB_URI=mongodb://127.0.0.1:27017/medimind_db?replicaSet=rs0

# Generate a long random value, for example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Comma-separated list of frontend origins allowed by CORS.
CLIENT_URL=http://localhost:5173

# Internal Python/FastAPI AI service. The browser never calls this directly.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_KEY=replace-with-a-shared-internal-key
AI_TIMEOUT_MS=8000

# Clinic local time offset from UTC in minutes (Sri Lanka is +330).
CLINIC_UTC_OFFSET_MINUTES=330
MAX_UPLOAD_BYTES=5242880
BCRYPT_ROUNDS=10

# Password given to every synthetic account created by npm run seed.
SEED_PASSWORD=MediMind123
SEED_RANDOM=20261116
